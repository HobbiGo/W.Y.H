
{%- comment -%} Visually-hidden page heading keeps the homepage's h1 contract while its regions provide the visible composition. {%- endcomment -%}
<h1 class="sr-only">{{ shop.name }}</h1>

{%- liquid
  assign hero_image = images['wyh-hero-platform.png']
  assign travel_image = images['wyh-travel-duffel.png']
  assign wallet_image = images['wyh-wallet.png']
  assign footwear_image = images['wyh-footwear.png']
  assign story_image = images['wyh-artisan.png']
  assign shop_url = routes.all_products_collection_url
  assign travel_url = shop_url
  if collections['travel-bags'].products_count > 0
    assign travel_url = collections['travel-bags'].url
  endif
  assign wallets_url = shop_url
  if collections['wallets-accessories'].products_count > 0
    assign wallets_url = collections['wallets-accessories'].url
  endif
  assign jackets_collection = collections['leather-jackets']
  assign jackets_image = images['wyh-jackets.jpg'] | default: jackets_collection.image | default: jackets_collection.products.first.featured_image
  assign jackets_url = shop_url
  if jackets_collection.products_count > 0
    assign jackets_url = jackets_collection.url
  endif
  assign footwear_url = shop_url
  if collections['leather-footwear'].products_count > 0
    assign footwear_url = collections['leather-footwear'].url
  endif
-%}

{%- comment -%} The known hero image source is mirrored by the index preload in layout/theme.liquid. {%- endcomment -%}
{%
  block 'container',
  class: 'relative isolate overflow-hidden min-h-[78svh] md:min-h-hero flex',
  background_image: hero_image,
  background_image_loading: 'eager',
  background_image_fetchpriority: 'high',
  background_image_sizes: '100vw',
  attributes: 'aria-labelledby="home-hero-heading"'
%}
  {%- unless hero_image -%}
    {% render 'placeholder-texture', kind: 'hero', seed: 1, class: 'absolute inset-0 aspect-auto -z-20' %}
  {%- endunless -%}

  {%- comment -%} Functional legibility wash: the photo melts into the surface so copy reads on any crop. {%- endcomment -%}
  <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-surface via-surface/55 to-surface/5"></div>
  <div class="pointer-events-none absolute inset-0 bg-linear-to-r from-surface/70 to-transparent max-md:hidden"></div>

  <div class="relative flex w-full max-w-page mx-auto flex-col items-center justify-end gap-4 px-margin pt-24 pb-14 text-center md:items-start md:text-start md:pb-24">
    {% block 'text', variant: 'type-overline', class: 'text-accent tracking-[0.3em]' %}
      {{- 'home.hero.eyebrow' | t -}}
    {% endblock %}

    {% block 'text', tag: 'h2', variant: 'type-display', class: 'max-w-3xl text-on-surface', attributes: 'id="home-hero-heading"' %}
      {{- 'home.hero.title' | t -}}
    {% endblock %}

    {% block 'text', variant: 'type-body-lg', class: 'max-w-md text-on-surface/80' %}
      {{- 'home.hero.subtitle' | t -}}
    {% endblock %}

    {% block 'button', url: shop_url, variant: 'button-primary', class: 'mt-2 h-12 px-8 rounded-button text-xs uppercase tracking-[0.2em]' %}
      {{- 'home.hero.cta' | t -}}
    {% endblock %}
  </div>
{% endblock %}

{%- assign category_sizes = '(min-width: 1280px) 300px, (min-width: 768px) 23vw, 45vw' -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin pt-10 pb-6 md:pt-20 md:pb-10', attributes: 'aria-labelledby="home-categories-heading"' %}
  {% block 'text', tag: 'h2', variant: 'type-heading-md', class: 'mb-6 text-center text-accent uppercase tracking-[0.2em] md:mb-10', attributes: 'id="home-categories-heading"' %}
    {{- 'home.categories.heading' | t -}}
  {% endblock %}

  <ul role="list" class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-6">
    <li>
      {%- assign travel_label = 'home.categories.travel_title' | t | replace: '&amp;', '&' -%}
      {% block 'card', url: travel_url, aria_label: travel_label, link_mode: 'card', alignment: 'text-center', border_radius: 'rounded-card', class: 'h-full gap-3 overflow-hidden border border-accent/25 bg-surface-secondary p-2.5 pb-4 hover:border-accent/70 motion-safe:transition-colors md:p-4 md:pb-6' %}
        <div class="overflow-hidden rounded-[calc(var(--radius-card)-4px)] aspect-square md:aspect-[4/5]">
          {% block 'image', fallback_image: travel_image, alt: travel_label, sizes: category_sizes, placeholder_kind: 'collection', seed: 2, attributes: 'loading="lazy"' %}{% endblock %}
        </div>
        {% block 'text', tag: 'h3', variant: 'type-heading-sm', class: 'text-accent uppercase tracking-[0.12em]' %}
          {{- 'home.categories.travel_title' | t -}}
        {% endblock %}
        {% block 'text', variant: 'type-body-sm', class: 'text-on-surface/80' %}
          {{- 'home.categories.travel_body' | t -}}
        {% endblock %}
      {% endblock %}
    </li>
    <li>
      {%- assign wallets_label = 'home.categories.wallets_title' | t | replace: '&amp;', '&' -%}
      {% block 'card', url: wallets_url, aria_label: wallets_label, link_mode: 'card', alignment: 'text-center', border_radius: 'rounded-card', class: 'h-full gap-3 overflow-hidden border border-accent/25 bg-surface-secondary p-2.5 pb-4 hover:border-accent/70 motion-safe:transition-colors md:p-4 md:pb-6' %}
        <div class="overflow-hidden rounded-[calc(var(--radius-card)-4px)] aspect-square md:aspect-[4/5]">
          {% block 'image', fallback_image: wallet_image, alt: wallets_label, sizes: category_sizes, placeholder_kind: 'collection', seed: 3, attributes: 'loading="lazy"' %}{% endblock %}
        </div>
        {% block 'text', tag: 'h3', variant: 'type-heading-sm', class: 'text-accent uppercase tracking-[0.12em]' %}
          {{- 'home.categories.wallets_title' | t -}}
        {% endblock %}
        {% block 'text', variant: 'type-body-sm', class: 'text-on-surface/80' %}
          {{- 'home.categories.wallets_body' | t -}}
        {% endblock %}
      {% endblock %}
    </li>
    <li>
      {%- assign footwear_label = 'home.categories.footwear_title' | t | replace: '&amp;', '&' -%}
      {% block 'card', url: footwear_url, aria_label: footwear_label, link_mode: 'card', alignment: 'text-center', border_radius: 'rounded-card', class: 'h-full gap-3 overflow-hidden border border-accent/25 bg-surface-secondary p-2.5 pb-4 hover:border-accent/70 motion-safe:transition-colors md:p-4 md:pb-6' %}
        <div class="overflow-hidden rounded-[calc(var(--radius-card)-4px)] aspect-square md:aspect-[4/5]">
          {% block 'image', fallback_image: footwear_image, alt: footwear_label, sizes: category_sizes, placeholder_kind: 'collection', seed: 4, attributes: 'loading="lazy"' %}{% endblock %}
        </div>
        {% block 'text', tag: 'h3', variant: 'type-heading-sm', class: 'text-accent uppercase tracking-[0.12em]' %}
          {{- 'home.categories.footwear_title' | t -}}
        {% endblock %}
        {% block 'text', variant: 'type-body-sm', class: 'text-on-surface/80' %}
          {{- 'home.categories.footwear_body' | t -}}
        {% endblock %}
      {% endblock %}
    </li>
    <li>
      {%- assign jackets_label = 'home.categories.jackets_title' | t | replace: '&amp;', '&' -%}
      {% block 'card', url: jackets_url, aria_label: jackets_label, link_mode: 'card', alignment: 'text-center', border_radius: 'rounded-card', class: 'h-full gap-3 overflow-hidden border border-accent/25 bg-surface-secondary p-2.5 pb-4 hover:border-accent/70 motion-safe:transition-colors md:p-4 md:pb-6' %}
        <div class="overflow-hidden rounded-[calc(var(--radius-card)-4px)] aspect-square md:aspect-[4/5]">
          {% block 'image', fallback_image: jackets_image, alt: jackets_label, sizes: category_sizes, placeholder_kind: 'collection', seed: 5, attributes: 'loading="lazy"' %}{% endblock %}
        </div>
        {% block 'text', tag: 'h3', variant: 'type-heading-sm', class: 'text-accent uppercase tracking-[0.12em]' %}
          {{- 'home.categories.jackets_title' | t -}}
        {% endblock %}
        {% block 'text', variant: 'type-body-sm', class: 'text-on-surface/80' %}
          {{- 'home.categories.jackets_body' | t -}}
        {% endblock %}
      {% endblock %}
    </li>
  </ul>
{% endblock %}

