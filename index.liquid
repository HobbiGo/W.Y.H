        {% block 'text', variant: 'type-body-sm', class: 'text-accent' %}{{ 189900000 | money }}{% endblock %}
      </li>
      <li class="flex flex-col gap-2">
        <div class="relative overflow-hidden rounded-card bg-surface-secondary aspect-[4/5]">
          {%- if sample_slate -%}<img src="{{ sample_slate | image_url: width: 1500 }}" width="{{ sample_slate.width }}" height="{{ sample_slate.height }}" alt="{{ 'home.samples.p2_title' | t }}" loading="lazy" class="absolute max-w-none h-auto" style="width:229.4%;left:-122.2%;top:0">{%- endif -%}
        </div>
        {% block 'text', tag: 'h3', variant: 'type-body-sm', class: 'font-medium text-on-surface line-clamp-2' %}{{ 'home.samples.p2_title' | t }}{% endblock %}
        {% block 'text', variant: 'type-body-sm', class: 'text-accent' %}{{ 209900000 | money }}{% endblock %}
      </li>
      <li class="flex flex-col gap-2">
        <div class="relative overflow-hidden rounded-card bg-surface-secondary aspect-[4/5]">
          {%- if sample_navy -%}<img src="{{ sample_navy | image_url: width: 1500 }}" width="{{ sample_navy.width }}" height="{{ sample_navy.height }}" alt="{{ 'home.samples.p3_title' | t }}" loading="lazy" class="absolute max-w-none h-auto" style="width:229.4%;left:-9.2%;top:0">{%- endif -%}
        </div>
        {% block 'text', tag: 'h3', variant: 'type-body-sm', class: 'font-medium text-on-surface line-clamp-2' %}{{ 'home.samples.p3_title' | t }}{% endblock %}
        {% block 'text', variant: 'type-body-sm', class: 'text-accent' %}{{ 299900000 | money }}{% endblock %}
      </li>
      <li class="flex flex-col gap-2">
        <div class="relative overflow-hidden rounded-card bg-surface-secondary aspect-[4/5]">
          {%- if sample_cognac -%}<img src="{{ sample_cognac | image_url: width: 2000 }}" width="{{ sample_cognac.width }}" height="{{ sample_cognac.height }}" alt="{{ 'home.samples.p4_title' | t }}" loading="lazy" class="absolute max-w-none h-auto" style="width:340%;left:-120.1%;top:-60.3%">{%- endif -%}
        </div>
        {% block 'text', tag: 'h3', variant: 'type-body-sm', class: 'font-medium text-on-surface line-clamp-2' %}{{ 'home.samples.p4_title' | t }}{% endblock %}
        {% block 'text', variant: 'type-body-sm', class: 'text-accent' %}{{ 149900000 | money }}{% endblock %}
