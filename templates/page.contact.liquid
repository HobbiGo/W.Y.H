
{% block 'container', class: 'w-full max-w-page mx-auto px-margin' %}
  {%- liquid
    assign name_error = ''
    assign email_error = ''
    assign phone_error = ''
    assign body_error = ''
  -%}

  <div class="grid grid-cols-1 gap-12 py-12 md:grid-cols-5">
    <div class="md:col-span-2">
      {% block 'text', tag: 'h1', variant: 'type-heading-xl', class: 'mb-6' %}{{ page.title | escape }}{% endblock %}

      {%- if page.content != blank -%}
        <div class="richtext text-on-surface-secondary">{{ page.content }}</div>
      {%- endif -%}
    </div>

    <div class="md:col-span-3">
      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <div role="status" tabindex="-1" autofocus class="mb-6 border-s-4 border-s-success bg-success/10 p-4 text-on-surface">
            <p class="type-body">{{ 'contact.success' | t }}</p>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div role="alert" tabindex="-1" autofocus class="mb-6 border-s-4 border-s-critical bg-critical/10 p-4 text-on-surface">
            <p class="type-body font-medium mb-1">{{ 'forms.form_errors_title' | t }}</p>
            <ul class="list-disc ps-4 text-sm">
              {% for field in form.errors %}
                <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
              {% endfor %}
            </ul>
          </div>

          {%- for field in form.errors -%}
            {%- capture field_error_message -%}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{%- endcapture -%}
            {%- case field -%}
              {%- when 'name' -%}
                {%- assign name_error = field_error_message -%}
              {%- when 'email' -%}
                {%- assign email_error = field_error_message -%}
              {%- when 'phone' -%}
                {%- assign phone_error = field_error_message -%}
              {%- when 'body' -%}
                {%- assign body_error = field_error_message -%}
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}

        <div class="flex flex-col gap-4">
          <div class="space-y-1.5">
            <label for="contact-name" class="block text-sm font-medium text-on-surface">
              {{- 'contact.name' | t -}}
              <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="contact[name]"
              class="border-on-surface aria-invalid:border-critical"
              value="{{ form.name | default: customer.name | escape }}"
              autocomplete="name"
              required
              aria-required="true"
              {%- if name_error != blank %} aria-invalid="true" aria-describedby="contact-name-error"{% endif %}
            >
            {%- if name_error != blank -%}
              <p id="contact-name-error" class="text-sm text-critical">{{ name_error | escape }}</p>
            {%- endif -%}
          </div>

          <div class="space-y-1.5">
            <label for="contact-email" class="block text-sm font-medium text-on-surface">
              {{- 'contact.email' | t -}}
              <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="contact[email]"
              class="border-on-surface aria-invalid:border-critical"
              value="{{ form.email | default: customer.email | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              aria-required="true"
              {%- if email_error != blank %} aria-invalid="true" aria-describedby="contact-email-error"{% endif %}
            >
            {%- if email_error != blank -%}
              <p id="contact-email-error" class="text-sm text-critical">{{ email_error | escape }}</p>
            {%- endif -%}
          </div>

          <div class="space-y-1.5">
            <label for="contact-phone" class="block text-sm font-medium text-on-surface">{{ 'contact.phone' | t }}</label>
            <input
              type="tel"
              id="contact-phone"
              name="contact[phone]"
              class="border-on-surface aria-invalid:border-critical"
              value="{{ form.phone | escape }}"
              autocomplete="tel"
              {%- if phone_error != blank %} aria-invalid="true" aria-describedby="contact-phone-error"{% endif %}
            >
            {%- if phone_error != blank -%}
              <p id="contact-phone-error" class="text-sm text-critical">{{ phone_error | escape }}</p>
            {%- endif -%}
          </div>

          <div class="space-y-1.5">
            <label for="contact-message" class="block text-sm font-medium text-on-surface">
              {{- 'contact.message' | t -}}
              <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
            </label>
            <textarea
              id="contact-message"
              name="contact[body]"
              class="border-on-surface aria-invalid:border-critical"
              rows="6"
              required
              aria-required="true"
              {%- if body_error != blank %} aria-invalid="true" aria-describedby="contact-message-error"{% endif %}
            >{{ form.body | escape }}</textarea>
            {%- if body_error != blank -%}
              <p id="contact-message-error" class="text-sm text-critical">{{ body_error | escape }}</p>
            {%- endif -%}
          </div>

          <div>
            {% block 'button', type: 'submit', class: 'h-11 px-4 text-sm rounded-button' %}{{- 'contact.submit' | t -}}{% endblock %}
          </div>
        </div>
      {% endform %}
    </div>
  </div>
{% endblock %}


