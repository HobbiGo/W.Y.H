
{% layout 'password' %}

{%- liquid
  assign launch_product = collections.all.products.first
  assign launch_fallback_image = shop.brand.cover_image | default: launch_product.featured_image
  assign launch_caption = shop.brand.slogan | default: shop.brand.short_description | default: shop.name
  assign launch_image_alt = launch_caption | default: shop.name

  assign password_title = 'password.title' | t
  assign password_eyebrow = 'password.eyebrow' | t
  assign password_launch_description = 'password.launch_description' | t
  assign password_enter = 'password.enter' | t
  assign password_enter_with_password = 'password.enter_with_password' | t
  assign password_enter_store = 'password.enter_store' | t
  assign password_show = 'password.show' | t
  assign password_hide = 'password.hide' | t
  assign password_get_updates = 'password.get_updates' | t
  assign password_updates_description = 'password.updates_description' | t
  assign password_updates_submit = 'password.updates_submit' | t
  assign password_updates_success = 'password.updates_success' | t
  assign password_field_label = 'password.field_label' | t
  assign password_placeholder = 'password.placeholder' | t
  assign password_error_message = 'password.error' | t
  assign email_label = 'contact.email' | t
  assign close_label = 'general.close' | t
  assign required_label = 'forms.required' | t
-%}

{%- comment -%} This template resolves its own brand image and first-product fallback; it does not depend on another template's composition. {%- endcomment -%}
{% block 'container', tag: 'div', class: 'group grid min-h-svh bg-surface lg:has-[figure_img]:grid-cols-[53%_47%]', attributes: 'data-password-page' %}
  <div class="order-1 mx-auto flex min-h-svh w-full max-w-3xl flex-col px-margin py-6 group-has-[figure_img]:min-h-[58svh] sm:py-8 lg:order-2 lg:group-has-[figure_img]:min-h-svh lg:group-has-[figure_img]:max-w-none lg:px-14 xl:px-20">
    {% block 'header', class: 'w-full shrink-0' %}
      {% block 'logo' %}{% endblock %}
    {% endblock %}

    <div class="flex flex-1 items-center py-12">
      <div class="w-full max-w-xl">
        {% block 'text', variant: 'type-overline', class: 'mb-8 text-on-surface-secondary' %}
          {{- password_eyebrow -}}
        {% endblock %}

        {% block 'text', tag: 'h1', variant: 'type-display', class: 'max-w-[13ch]' %}
          {%- if shop.password_message != blank -%}
            {{- shop.password_message | escape -}}
          {%- else -%}
            {{- password_title -}}
          {%- endif -%}
        {% endblock %}

        {% block 'text', variant: 'type-body-lg', class: 'mt-6 max-w-prose text-on-surface-secondary' %}
          {{- password_launch_description -}}
        {% endblock %}

        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6">
          {%- capture password_trigger_attrs -%}id="password-entry-trigger" aria-haspopup="dialog" aria-controls="password-entry-dialog"{%- endcapture -%}
          {% block 'button', commandfor: 'password-entry-dialog', command: 'show-modal', variant: 'button-primary', class: 'min-h-touch-target px-5 rounded-button', attributes: password_trigger_attrs %}
            {{- password_enter_with_password -}}
          {% endblock %}

          {%- capture updates_trigger_attrs -%}id="password-updates-trigger" aria-haspopup="dialog" aria-controls="password-updates-dialog"{%- endcapture -%}
          {% block 'button', commandfor: 'password-updates-dialog', command: 'show-modal', variant: 'button-ghost', class: 'min-h-touch-target px-0 rounded-none font-normal underline decoration-border underline-offset-4 hover:bg-transparent hover:decoration-current', attributes: updates_trigger_attrs %}
            {{- password_get_updates -}}
          {% endblock %}
        </div>

        <noscript>
          <div class="mt-8 space-y-4 border-t border-border pt-6">
            {% form 'storefront_password', id: 'password-entry-fallback' %}
              <details open>
                <summary class="min-h-touch-target cursor-pointer py-3 font-medium">{{ password_enter_with_password }}</summary>
                <div class="mt-3 space-y-4">
                  {%- if form.errors -%}
                    <p id="password-fallback-error" class="text-sm text-critical" role="alert">{{ password_error_message }}</p>
                  {%- endif -%}
                  <div class="space-y-1.5">
                    <label for="password-fallback" class="block text-sm font-medium text-on-surface">{{ password_field_label }}</label>
                    <input
                      type="password"
                      name="password"
                      id="password-fallback"
                      placeholder="{{ password_placeholder | escape }}"
                      autocomplete="current-password"
                      required
                      aria-required="true"
                      {%- if form.errors %} aria-invalid="true" aria-describedby="password-fallback-error"{% endif %}
                    >
                  </div>
                  {% block 'button', type: 'submit', variant: 'button-primary', class: 'min-h-touch-target w-full px-5 rounded-button' %}{{ password_enter }}{% endblock %}
                </div>
              </details>
            {% endform %}

            {% form 'customer', id: 'password-updates-fallback' %}
              <details {% if form.posted_successfully? or form.errors %}open{% endif %}>
                <summary class="min-h-touch-target cursor-pointer py-3 font-medium">{{ password_get_updates }}</summary>
                <div class="mt-3 space-y-4">
                  {%- if form.posted_successfully? -%}
                    <p role="status">{{ password_updates_success }}</p>
                  {%- else -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    {%- if form.errors -%}
                      <div id="password-updates-fallback-error" class="text-sm text-critical" role="alert">
                        <p class="font-medium">{{ 'forms.form_errors_title' | t }}</p>
                        <ul class="mt-1 list-disc ps-4">
                          {%- for field in form.errors -%}
                            <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                    <div class="space-y-1.5">
                      <label for="password-updates-fallback-email" class="block text-sm font-medium text-on-surface">
                        {{- email_label -}}
                        <span class="ms-0.5 text-critical" aria-hidden="true">*</span><span class="sr-only"> ({{ required_label }})</span>
                      </label>
                      <input
                        type="email"
                        id="password-updates-fallback-email"
                        name="contact[email]"
                        value="{{ form.email | escape }}"
                        autocomplete="email"
                        autocorrect="off"
                        autocapitalize="off"
                        required
                        aria-required="true"
                        {%- if form.errors %} aria-invalid="true" aria-describedby="password-updates-fallback-error"{% endif %}
                      >
                    </div>
                    {% block 'button', type: 'submit', variant: 'button-primary', class: 'min-h-touch-target w-full px-5 rounded-button' %}{{ password_updates_submit }}{% endblock %}
                  {%- endif -%}
                </div>
              </details>
            {% endform %}
          </div>
        </noscript>
      </div>
    </div>

    {% block 'footer', class: 'w-full shrink-0' %}
      <div class="flex flex-col gap-2 border-t border-border pt-6 text-xs text-on-surface-secondary sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
        <p class="break-all">{{ shop.permanent_domain | escape }}</p>
      </div>
    {% endblock %}

    {%- comment -%} Shopify owns password validation and access/session redirects; the dialog is only a focused presentation of the native form. {%- endcomment -%}
    {% form 'storefront_password', id: 'password-entry-form', class: 'absolute' %}
      <s-dialog {% if form.errors %}open-on-connect{% endif %} reset-on-close>
        <dialog id="password-entry-dialog" class="overlay-panel [--panel-closed-transform:translateY(16px)_scale(0.96)] m-auto rounded-lg w-[min(560px,90vw,calc(100vw-var(--safe-area-inset-inline)-var(--safe-area-inset-inline)))] max-h-dialog-max-height max-w-md overflow-y-auto p-6 sm:p-8" aria-labelledby="password-entry-title">
          {%- capture password_close_attrs -%}aria-label="{{ close_label | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'password-entry-dialog', command: 'close', variant: 'button-ghost', class: 'absolute end-3 top-3 size-touch-target rounded-full hover:bg-surface-secondary', attributes: password_close_attrs %}<span class="inline-flex size-5 items-center justify-center" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}

          {% block 'text', tag: 'h2', variant: 'type-heading-lg', class: 'pe-12', attributes: 'id="password-entry-title"' %}
            {{- password_enter_store -}}
          {% endblock %}

          <div class="mt-7 space-y-5">
            <div class="space-y-1.5">
              <label for="password-entry" class="block text-sm font-medium text-on-surface">{{ password_field_label }}</label>
              <div class="relative">
                <input
                  type="password"
                  name="password"
                  id="password-entry"
                  class="h-12 pe-28"
                  placeholder="{{ password_placeholder | escape }}"
                  autocomplete="current-password"
                  required
                  aria-required="true"
                  autofocus
                  {%- if form.errors %} aria-invalid="true" aria-describedby="password-entry-error"{% endif %}
                >
                {%- capture password_toggle_attrs -%}aria-controls="password-entry" aria-pressed="false" data-show-label="{{ password_show | escape }}" data-hide-label="{{ password_hide | escape }}"{%- endcapture -%}
                {% block 'button', commandfor: 'password-entry-dialog', command: '--toggle-password', variant: 'button-ghost', class: 'absolute inset-y-1 end-1 min-w-touch-target rounded-button px-3 text-sm hover:bg-surface-secondary', attributes: password_toggle_attrs %}<span data-password-toggle-label>{{ password_show }}</span>{% endblock %}
              </div>
              {%- if form.errors -%}
                <p id="password-entry-error" data-dialog-error class="text-sm text-critical" role="alert">{{ password_error_message }}</p>
              {%- endif -%}
            </div>

            {% block 'button', type: 'submit', variant: 'button-primary', class: 'min-h-touch-target w-full px-5 rounded-button' %}{{ password_enter_store }}{% endblock %}
          </div>
        </dialog>
      </s-dialog>
    {% endform %}

    {% form 'customer', id: 'password-updates-form', class: 'absolute' %}
      <s-dialog {% if form.posted_successfully? or form.errors %}open-on-connect{% endif %}>
        <dialog id="password-updates-dialog" class="overlay-panel [--panel-closed-transform:translateY(16px)_scale(0.96)] m-auto rounded-lg w-[min(560px,90vw,calc(100vw-var(--safe-area-inset-inline)-var(--safe-area-inset-inline)))] max-h-dialog-max-height max-w-md overflow-y-auto p-6 sm:p-8" aria-labelledby="password-updates-title">
          {%- capture updates_close_attrs -%}aria-label="{{ close_label | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'password-updates-dialog', command: 'close', variant: 'button-ghost', class: 'absolute end-3 top-3 size-touch-target rounded-full hover:bg-surface-secondary', attributes: updates_close_attrs %}<span class="inline-flex size-5 items-center justify-center" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}

          {% block 'text', tag: 'h2', variant: 'type-heading-lg', class: 'pe-12', attributes: 'id="password-updates-title"' %}
            {{- password_get_updates -}}
          {% endblock %}

          {%- if form.posted_successfully? -%}
            <p class="mt-6 type-body" role="status" tabindex="-1" autofocus>{{ password_updates_success }}</p>
          {%- else -%}
            {% block 'text', variant: 'type-body', class: 'mt-4 text-on-surface-secondary' %}
              {{- password_updates_description -}}
            {% endblock %}

            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="mt-7 space-y-5">
              {%- if form.errors -%}
                <div id="password-updates-error" class="text-sm text-critical" role="alert">
                  <p class="font-medium">{{ 'forms.form_errors_title' | t }}</p>
                  <ul class="mt-1 list-disc ps-4">
                    {%- for field in form.errors -%}
                      <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              <div class="space-y-1.5">
                <label for="password-updates-email" class="block text-sm font-medium text-on-surface">
                  {{- email_label -}}
                  <span class="ms-0.5 text-critical" aria-hidden="true">*</span><span class="sr-only"> ({{ required_label }})</span>
                </label>
                <input
                  type="email"
                  id="password-updates-email"
                  name="contact[email]"
                  value="{{ form.email | escape }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  aria-required="true"
                  autofocus
                  {%- if form.errors %} aria-invalid="true" aria-describedby="password-updates-error"{% endif %}
                >
              </div>

              {% block 'button', type: 'submit', variant: 'button-primary', class: 'min-h-touch-target w-full px-5 rounded-button' %}{{ password_updates_submit }}{% endblock %}
            </div>
          {%- endif -%}
        </dialog>
      </s-dialog>
    {% endform %}
  </div>

  <figure class="relative order-2 hidden min-h-[42svh] overflow-hidden bg-surface-secondary group-has-[figure_img]:block lg:order-1 lg:group-has-[figure_img]:min-h-svh">
    {%- comment -%} The image block setting wins; Brand cover art and then the homepage-style first-product image are fallback data only. {%- endcomment -%}
    {% block 'image', fallback_image: launch_fallback_image, sizes: '(min-width: 1024px) 53vw, 100vw', alt: launch_image_alt, class: 'absolute inset-0 aspect-auto', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
    {%- if launch_caption != blank -%}
      <figcaption class="absolute bottom-6 start-6 max-w-[calc(100%-3rem)] bg-surface px-3 py-2 text-xs text-on-surface">
        {{- launch_caption | escape -}}
      </figcaption>
    {%- endif -%}
  </figure>
{% endblock %}

<script type="module" src="{{ 's-dialog.js' | asset_url }}"></script>


